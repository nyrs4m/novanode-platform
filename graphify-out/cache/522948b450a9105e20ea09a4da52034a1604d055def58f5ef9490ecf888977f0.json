{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"superadminpanel","label":"SuperAdminPanel.tsx","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L1"}]},{"id":"superadminpanel_superadminpanelprops","label":"SuperAdminPanelProps","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L31-L37","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L31"}],"snippet":"interface SuperAdminPanelProps {\n  adminEmail: string;\n  restaurants: Restaurant[];\n  ledgers: DailyLedger[];\n  totalOrders: number;\n  totalSessions: number;\n}"},{"id":"superadminpanel_superadminpanel","label":"SuperAdminPanel()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L41-L939","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L41"}],"snippet":"export default function SuperAdminPanel({\n  adminEmail,\n  restaurants,\n  ledgers: initialLedgers,\n  totalOrders,\n  totalSessions,\n}: SuperAdminPanelProps) {\n  const [tab, setTab] = useState<Tab>(\"overview\");\n  const [restaurantList, setRestaurantList] = useState(restaurants);\n  const [ledgers, setLedgers] = useState<DailyLedger[]>(initialLedgers);\n  const [updatingId, setUpdatingId] = useState<string | null>(null);\n  const [onboardForm, setOnboardForm] = useState({\n    name: \"\",\n    slug: \"\",\n    currency: \"GHS\",\n    closing_time: \"22:00\",\n    staff_email: \"\",\n    staff_password: \"\",\n  });\n  const [onboarding, setOnboarding] = useState(false);\n  const [feeForm, setFeeForm] = useState<Record<string, string>>({});\n  const router = useRouter();\n  const supabaseRef = useRef(createClient());\n\n  // ── Realtime: refresh ledgers on any change ───────────────────────────","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"superadminpanel_superadminpanel_refreshtodayledger","label":"refreshTodayLedger()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L69-L75","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L69"}],"snippet":"async function refreshTodayLedger() {\n      const { data } = await supabaseClient\n        .from(\"daily_ledger\")\n        .select(\"*\")\n        .eq(\"ledger_date\", today);\n      if (data) setLedgers(data as DailyLedger[]);\n    }"},{"id":"superadminpanel_superadminpanel_togglesuspend","label":"toggleSuspend()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L109-L129","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L109"}],"snippet":"async function toggleSuspend(restaurant: Restaurant) {\n    setUpdatingId(restaurant.id);\n    const newActive = !restaurant.is_active;\n    const { error } = await supabaseRef.current\n      .from(\"restaurants\")\n      .update({\n        is_active: newActive,\n        suspended_at: newActive ? null : new Date().toISOString(),\n        suspension_reason: newActive ? null : \"Suspended by NovaNode admin\",\n      })\n      .eq(\"id\", restaurant.id);\n\n    if (!error) {\n      setRestaurantList((prev) =>\n        prev.map((r) =>\n          r.id === restaurant.id ? { ...r, is_active: newActive } : r\n        )\n      );\n    }\n    setUpdatingId(null);\n  }"},{"id":"superadminpanel_superadminpanel_updatesessionfee","label":"updateSessionFee()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L131-L154","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L131"}],"snippet":"async function updateSessionFee(restaurantId: string) {\n    const fee = parseFloat(feeForm[restaurantId]);\n    if (isNaN(fee) || fee < 0) {\n      alert(\"Invalid fee\");\n      return;\n    }\n    setUpdatingId(restaurantId);\n    const { error } = await supabaseRef.current\n      .from(\"restaurants\")\n      .update({ session_fee: fee })\n      .eq(\"id\", restaurantId);\n\n    if (!error) {\n      setRestaurantList((prev) =>\n        prev.map((r) => (r.id === restaurantId ? { ...r, session_fee: fee } : r))\n      );\n      setFeeForm((prev) => {\n        const n = { ...prev };\n        delete n[restaurantId];\n        return n;\n      });\n    }\n    setUpdatingId(null);\n  }"},{"id":"superadminpanel_superadminpanel_clearoverdue","label":"clearOverdue()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L156-L166","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L156"}],"snippet":"async function clearOverdue(restaurantId: string) {\n    await supabaseRef.current\n      .from(\"restaurants\")\n      .update({ payment_overdue: false })\n      .eq(\"id\", restaurantId);\n    setRestaurantList((prev) =>\n      prev.map((r) =>\n        r.id === restaurantId ? { ...r, payment_overdue: false } : r\n      )\n    );\n  }"},{"id":"superadminpanel_superadminpanel_onboardrestaurant","label":"onboardRestaurant()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L168-L226","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L168"}],"snippet":"async function onboardRestaurant() {\n    if (\n      !onboardForm.name ||\n      !onboardForm.slug ||\n      !onboardForm.staff_email ||\n      !onboardForm.staff_password\n    ) {\n      alert(\"All fields are required\");\n      return;\n    }\n    setOnboarding(true);\n    try {\n      const { data: newRestaurant, error: restError } = await supabaseRef.current\n        .from(\"restaurants\")\n        .insert({\n          name: onboardForm.name,\n          slug: onboardForm.slug.toLowerCase().replace(/\\s+/g, \"-\"),\n          currency: onboardForm.currency,\n          is_active: true,\n          // No flat session_fee — platform uses 1% dynamic rate\n        })\n        .select()\n        .maybeSingle();\n\n      if (restError) throw restError;"},{"id":"superadminpanel_superadminpanel_handlelogout","label":"handleLogout()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(novanode)/novanode/components/SuperAdminPanel.tsx","source_location":"L228-L231","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novano