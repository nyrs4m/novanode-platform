>(initialOrders);\n  const [sessions, setSessions] = useState<Session[]>(initialSessions);\n  const [signals, setSignals] = useState<Signal[]>(initialSignals);\n  const [items, setItems] = useState<MenuItem[]>(menuItems);\n  const [updatingOrder, setUpdatingOrder] = useState<string | null>(null);\n  const [revenue, setRevenue] = useState(todayRevenue);\n  const [orderCount, setOrderCount] = useState(todayCount);\n  const [ledger, setLedger] = useState<LedgerRow | null>(null);\n  const [payingLedger, setPayingLedger] = useState(false);\n  const [closingTable, setClosingTable] = useState<string | null>(null);\n  const [unpaidLedgers, setUnpaidLedgers] = useState<{\n    ledger_date: string;\n    total_owed: number;\n  }[]>([]);\n\n  const [activeTab, setActiveTab] = useState<KDSTab>(\"orders\");","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"kdsboard_kdsboard_checkclosingtime","label":"checkClosingTime()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L277-L304","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L277"}],"snippet":"function checkClosingTime() {\n      const now = new Date();\n      const [hours, minutes] = restaurant.closing_time!.split(\":\").map(Number);\n      const closing = new Date();\n      closing.setHours(hours, minutes, 0, 0);\n\n      const diffMs = closing.getTime() - now.getTime();\n      const diffMins = diffMs / 60000;\n\n      if (diffMins <= 0) {\n        // Only show overdue if there's an unpaid balance\n        const hasOutstanding = (ledger && Number(ledger.total_owed ?? 0) > 0) || unpaidLedgers.length > 0;\n        if (hasOutstanding) {\n          setClosingWarning('overdue');\n          supabaseRef.current\n            .from('restaurants')\n            .update({ payment_overdue: true } as any)\n            .eq('id', restaurant.id)\n            .then(() => {})\n        } else {\n          setClosingWarning(null)\n        }\n      } else if (diffMins <= 30) {\n        setClosingWarning(\"approaching\");\n      } else {"},{"id":"kdsboard_kdsboard_updateorderstatus","label":"updateOrderStatus()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L315-L329","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L315"}],"snippet":"async function updateOrderStatus(orderId: string, newStatus: string) {\n    setUpdatingOrder(orderId);\n    const { error } = await supabaseRef.current\n      .from(\"orders\")\n      .update({ status: newStatus })\n      .eq(\"id\", orderId);\n\n    if (!error) {\n      // Optimistic update — don't wait for realtime\n      setOrders((prev) =>\n        prev.map((o) => (o.id === orderId ? { ...o, status: newStatus } : o)),\n      );\n    }\n    setUpdatingOrder(null);\n  }"},{"id":"kdsboard_kdsboard_updateorderstatuswithtime","label":"updateOrderStatusWithTime()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L331-L357","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L331"}],"snippet":"async function updateOrderStatusWithTime(orderId: string, minutes: number) {\n    setUpdatingOrder(orderId);\n    const { error } = await supabaseRef.current\n      .from(\"orders\")\n      .update({\n        status: \"Preparing\",\n        estimated_minutes: minutes,\n        preparation_started_at: new Date().toISOString(),\n      })\n      .eq(\"id\", orderId);\n\n    if (!error) {\n      setOrders((prev) =>\n        prev.map((o) =>\n          o.id === orderId\n            ? {\n                ...o,\n                status: \"Preparing\",\n                estimated_minutes: minutes,\n                preparation_started_at: new Date().toISOString(),\n              }\n            : o,\n        ),\n      );\n    }"},{"id":"kdsboard_kdsboard_resolvesignal","label":"resolveSignal()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L359-L364","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L359"}],"snippet":"async function resolveSignal(signalId: string) {\n    await supabaseRef.current\n      .from(\"waiter_signals\")\n      .update({ is_resolved: true })\n      .eq(\"id\", signalId);\n  }"},{"id":"kdsboard_kdsboard_togglestock","label":"toggleStock()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L366-L374","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L366"}],"snippet":"async function toggleStock(itemId: string, current: boolean) {\n    await supabaseRef.current\n      .from(\"menu_items\")\n      .update({ is_available: !current })\n      .eq(\"id\", itemId);\n    setItems((prev) =>\n      prev.map((i) => (i.id === itemId ? { ...i, is_available: !current } : i)),\n    );\n  }"},{"id":"kdsboard_kdsboard_fetchledger","label":"fetchLedger()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L376-L396","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L376"}],"snippet":"async function fetchLedger() {\n    const today = new Date().toISOString().split(\"T\")[0];\n    const { data } = await supabaseRef.current\n      .from(\"daily_ledger\")\n      .select(\"*\")\n      .eq(\"restaurant_id\", restaurant.id)\n      .eq(\"ledger_date\", today)\n      .maybeSingle();\n    if (data) setLedger(data as LedgerRow);\n\n    // Fetch unpaid previous days\n    const { data: unpaid } = await supabaseRef.current\n      .from(\"daily_ledger\")\n      .select(\"ledger_date, total_owed\")\n      .eq(\"restaurant_id\", restaurant.id)\n      .eq(\"is_paid\", false)\n      .lt(\"ledger_date\", today)\n      .gt(\"total_owed\", 0)\n      .order(\"ledger_date\", { ascending: false });\n    setUnpaidLedgers(unpaid ?? []);\n  }"},{"id":"kdsboard_kdsboard_closetable","label":"closeTable()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L398-L447","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L398"}],"snippet":"async function closeTable(sessionId: string) {\n    if (closingTable === sessionId) return;\n    setClosingTable(sessionId);\n\n    const session = sessions.find((s) => s.id === sessionId);\n    if (!session) {\n      setClosingTable(null);\n      return;\n    }\n\n    const sessionOrders = orders.filter(\n      (o) =>\n        o.session_token === session.session_token && o.status !== \"Cancelled\",\n    );\n    const foodTotal = sessionOrders.reduce(\n      (s, o) => s + Number(o.total_amount),\n      0,\n    );\n    const dynamicFee = Math.min(Math.round(foodTotal * 0.01 * 100) / 100, 5);\n\n    await supabaseRef.current\n      .from(\"table_sessions\")\n      .update({\n        is_active: false,\n        status: \"completed\","},{"id":"kdsboard_kdsboard_timeago","label":"TimeAgo()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L450-L466","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L450"}],"snippet":"function TimeAgo({ date }: { date: string }) {\n    const [display, setDisplay] = useState(() => {\n      const diff = Math.floor((Date.now() - new Date(date).getTime()) / 60000)\n      return diff < 1 ? 'just now' : `${diff}m ago`\n    })\n\n    useEffect(() => {\n      const update = () => {\n        const diff = Math.floor((Date.now() - new Date(date).getTime()) / 60000)\n        setDisplay(diff < 1 ? 'just now' : `${diff}m ago`)\n      }\n      const interval = setInterval(update, 60000)\n      return () => clearInterval(interval)\n    }, [date])\n\n    return <span>{display}</span>\n  }"},{"id":"kdsboard_kdsboard_timeago_update","label":"update()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L457-L460","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/kds/[restaurant_slug]/components/KDSBoard.tsx","source_location":"L457"}],"snippet":"update = () => {\n        const diff = Math.floor((Date.now() - new Date(date).getTime()) / 60000)\n        setDisplay(diff < 1 ? 'just now' : `${diff}m ago`)\n      }"}],"edges":[{"source":"k