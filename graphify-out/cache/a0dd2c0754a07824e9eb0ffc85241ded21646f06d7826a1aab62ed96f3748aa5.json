{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"dashboardhome","label":"DashboardHome.tsx","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L1"}]},{"id":"dashboardhome_props","label":"Props","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L39-L52","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L39"}],"snippet":"interface Props {\n  restaurant: Restaurant;\n  staff: Tables<\"restaurant_staff\">;\n  dailyStats: RestaurantStats | null;\n  monthRevenue: number;\n  monthCount: number;\n  topItems: MenuItemStats[];\n  peakHours: PeakHourStats[];\n  recentOrders: Order[];\n  activeOrdersCount: number;\n  activeTablesCount: number;\n  signalsCount: number;\n  todayRevenueOverride: number;\n}"},{"id":"dashboardhome_statusicon","label":"StatusIcon()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L56-L59","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L56"}],"snippet":"function StatusIcon({ status }: { status: string }) {\n  if (status === \"Cancelled\") return <XCircle size={14} color=\"#f87171\" />;\n  return <CheckCircle size={14} color=\"#34d399\" />;\n}","node_kind":"component"},{"id":"dashboardhome_statuslabel","label":"StatusLabel()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L61-L67","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L61"}],"snippet":"function StatusLabel({ status }: { status: string }) {\n  if (status === \"Completed\")\n    return <span className=\"status-done\">{status}</span>;\n  if (status === \"Cancelled\")\n    return <span className=\"status-cancel\">{status}</span>;\n  return <span className=\"status-pending\">{status}</span>;\n}","node_kind":"component"},{"id":"dashboardhome_dashboardhome","label":"DashboardHome()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L78-L2081","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L78"}],"snippet":"export default function DashboardHome({\n  restaurant,\n  dailyStats,\n  monthRevenue,\n  monthCount,\n  topItems,\n  peakHours,\n  todayRevenueOverride,\n  recentOrders: initialRecentOrders,\n  activeOrdersCount: initialActiveOrders,\n  activeTablesCount: initialActiveTables,\n  signalsCount: initialSignals,\n}: Props) {\n  const [tab, setTab] = useState<Tab>(\"overview\");\n  const router = useRouter();\n  const [isPending, startTransition] = useTransition();\n\n  // ── Live counts — seeded from server render, kept fresh via realtime ──\n  const [activeOrdersCount, setActiveOrdersCount] =\n    useState(initialActiveOrders);\n  const [activeTablesCount, setActiveTablesCount] =\n    useState(initialActiveTables);\n  const [signalsCount, setSignalsCount] = useState(initialSignals);\n  const [recentOrders, setRecentOrders] =\n    useState<Order[]>(initialRecentOrders);","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"dashboardhome_dashboardhome_checkclosingtime","label":"checkClosingTime()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L175-L193","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L175"}],"snippet":"function checkClosingTime() {\n      const now = new Date();\n      const [hours, minutes] = restaurant.closing_time!.split(\":\").map(Number);\n      const closing = new Date();\n      closing.setHours(hours, minutes, 0, 0);\n\n      const diffMs = closing.getTime() - now.getTime();\n      const diffMins = diffMs / 60000;\n\n      if (diffMins <= 0) {\n        const hasOutstanding =\n          todayLedger && Number(todayLedger?.total_owed ?? 0) > 0;\n        setClosingWarning(hasOutstanding ? \"overdue\" : null);\n      } else if (diffMins <= 30) {\n        setClosingWarning(\"approaching\");\n      } else {\n        setClosingWarning(null);\n      }\n    }"},{"id":"dashboardhome_dashboardhome_refreshtodayrevenue","label":"refreshTodayRevenue()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L219-L259","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L219"}],"snippet":"async function refreshTodayRevenue() {\n      const today = new Date().toISOString().split(\"T\")[0];\n      const todayStart = `${today}T00:00:00.000Z`;\n      const tomorrowStartDate = new Date(todayStart);\n      tomorrowStartDate.setUTCDate(tomorrowStartDate.getUTCDate() + 1);\n      const tomorrowStart = tomorrowStartDate.toISOString();\n\n      try {\n        // Fetch completed session tokens for today\n        const { data: completedSessions } = await supabaseRef.current\n          .from(\"table_sessions\")\n          .select(\"session_token\")\n          .eq(\"restaurant_id\", restaurant.id)\n          .eq(\"status\", \"completed\")\n          .gte(\"closed_at\", todayStart)\n          .lt(\"closed_at\", tomorrowStart);\n\n        const completedSessionTokens =\n          completedSessions?.map((s) => s.session_token) ?? [];\n\n        // Fetch orders from completed sessions\n        if (completedSessionTokens.length > 0) {\n          const { data: revenueOrders } = await supabaseRef.current\n            .from(\"orders\")\n            .select(\"total_amount\")"},{"id":"dashboardhome_dashboardhome_refreshcounts","label":"refreshCounts()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L261-L306","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L261"}],"snippet":"async function refreshCounts() {\n      // Run revenue refresh in parallel without blocking other counts\n      refreshTodayRevenue().catch(() => {});\n\n      const [ordersRes, tablesRes, signalsRes, recentRes, ledgerRes] =\n        await Promise.all([\n          supabaseRef.current\n            .from(\"orders\")\n            .select(\"*\", { count: \"exact\", head: true })\n            .eq(\"restaurant_id\", restaurant.id)\n            .in(\"status\", [\"Pending\", \"Preparing\"]),\n\n          supabaseRef.current\n            .from(\"table_sessions\")\n            .select(\"*\", { count: \"exact\", head: true })\n            .eq(\"restaurant_id\", restaurant.id)\n            .eq(\"is_active\", true),\n\n          supabaseRef.current\n            .from(\"waiter_signals\")\n            .select(\"*\", { count: \"exact\", head: true })\n            .eq(\"restaurant_id\", restaurant.id)\n            .eq(\"is_resolved\", false),\n\n          supabaseRef.current"},{"id":"dashboardhome_dashboardhome_fetchanalytics","label":"fetchAnalytics()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L381-L392","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L381"}],"snippet":"async function fetchAnalytics() {\n    setAnalyticsLoading(true);\n    try {\n      const res = await fetch(`/api/analytics?restaurant_id=${restaurant.id}`);\n      const data = await res.json();\n      setAnalyticsData(data);\n    } catch (e) {\n      console.error(\"Analytics fetch failed:\", e);\n    } finally {\n      setAnalyticsLoading(false);\n    }\n  }"},{"id":"dashboardhome_dashboardhome_handlelogout","label":"handleLogout()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L406-L411","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L406"}],"snippet":"async function handleLogout() {\n    await supabaseRef.current.auth.signOut();\n    startTransition(() => {\n      router.push(\"/login\");\n    });\n  }"},{"id":"dashboardhome_dashboardhome_fetchpromos","label":"fetchPromos()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L413-L420","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L413"}],"snippet":"async function fetchPromos() {\n    const { data } = await supabaseRef.current\n      .from(\"restaurant_promos\")\n      .select(\"*\")\n      .eq(\"restaurant_id\", restaurant.id)\n      .order(\"created_at\", { ascending: false });\n    setPromos((data as any) ?? []);\n  }"},{"id":"dashboardhome_dashboardhome_fetchstaff","label":"fetchStaff()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L422-L428","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L422"}],"snippet":"async function fetchStaff() {\n    const { data } = await supabaseRef.current\n      .from(\"restaurant_staff\")\n      .select(\"id, display_name, role\")\n      .eq(\"restaurant_id\", restaurant.id);\n    setStaffList((data as any) ?? []);\n  }"},{"id":"dashboardhome_dashboardhome_saveprofile","label":"saveProfile()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L430-L463","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L430"}],"snippet":"async function saveProfile() {\n  setProfileSaving(true)\n  try {\n    console.log('[Profile] Saving:', profileForm, 'id:', restaurant.id)\n    \n    const { data, error } = await supabaseRef.current\n      .from('restaurants')\n      .update({\n        name: profileForm.name,\n        description: profileForm.description,\n        opening_time: profileForm.opening_time || null,\n        closing_time: profileForm.closing_time || null,\n        contact_number: profileForm.contact_number,\n        address: profileForm.address,\n      } as any)\n      .eq('id', restaurant.id)\n      .select()\n\n    console.log('[Profile] Result:', data, error)\n\n    if (error) {\n      console.error('[Profile] Save failed:', error)\n      return\n    }"},{"id":"dashboardhome_dashboardhome_handlelogoupload","label":"handleLogoUpload()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L465-L488","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L465"}],"snippet":"async function handleLogoUpload(e: React.ChangeEvent<HTMLInputElement>) {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    setLogoUploading(true);\n    try {\n      const url = await uploadMenuImage(\n        file,\n        restaurant.id,\n        supabaseRef.current,\n      );\n      if (url) {\n        await supabaseRef.current\n          .from(\"restaurants\")\n          .update({ logo_url: url } as any)\n          .eq(\"id\", restaurant.id);\n        setLogoUrl(url);\n        await fetch(\"/api/revalidate?tag=restaurant\", { method: \"POST\" });\n      }\n    } catch (e) {\n      console.error(\"Logo upload failed:\", e);\n    } finally {\n      setLogoUploading(false);\n    }\n  }"},{"id":"dashboardhome_dashboardhome_savepromo","label":"savePromo()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L490-L513","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L490"}],"snippet":"async function savePromo() {\n    if (!promoForm.title || !promoForm.start_date || !promoForm.end_date)\n      return;\n    setPromoSaving(true);\n    try {\n      await supabaseRef.current.from(\"restaurant_promos\").insert({\n        restaurant_id: restaurant.id,\n        title: promoForm.title,\n        description: promoForm.description,\n        start_date: promoForm.start_date,\n        end_date: promoForm.end_date,\n        is_active: true,\n      } as any);\n      setPromoForm({\n        title: \"\",\n        description: \"\",\n        start_date: \"\",\n        end_date: \"\",\n      });\n      await fetchPromos();\n    } finally {\n      setPromoSaving(false);\n    }\n  }"},{"id":"dashboardhome_dashboardhome_deletepromo","label":"deletePromo()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L515-L518","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L515"}],"snippet":"async function deletePromo(id: string) {\n    await supabaseRef.current.from(\"restaurant_promos\").delete().eq(\"id\", id);\n    await fetchPromos();\n  }"},{"id":"dashboardhome_dashboardhome_updatestaffname","label":"updateStaffName()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L520-L526","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L520"}],"snippet":"async function updateStaffName(id: string, name: string) {\n    await supabaseRef.current\n      .from(\"restaurant_staff\")\n      .update({ display_name: name } as any)\n      .eq(\"id\", id);\n    await fetchStaff();\n  }"}],"edges":[{"source":"dashboardhome","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L3"}],"weight":1},{"source":"dashboardhome","target":"navigation","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L4","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L4"}],"weight":1},{"source":"dashboardhome","target":"lucide_react","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L5","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L5"}],"weight":1},{"s