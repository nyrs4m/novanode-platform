tegory_id: item.category_id ?? \"\",\n      image_url: item.image_url,\n      is_available: item.is_available ?? true,\n      is_starter: item.is_starter ?? false,\n    });\n    setEditingItem(item);\n    setView(\"edit-item\");\n  }"},{"id":"menumanager_menumanager_handleimageupload","label":"handleImageUpload()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L127-L148","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L127"}],"snippet":"async function handleImageUpload(e: React.ChangeEvent<HTMLInputElement>) {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    setUploadingImage(true);\n    try {\n      const compressed = await compressImage(file);\n      const fileName = `${restaurant.id}/${Date.now()}.webp`;\n      const { error } = await supabase.storage\n        .from(\"menu-images\")\n        .upload(fileName, compressed, { contentType: \"image/webp\" });\n      if (error) throw error;\n      const { data } = supabase.storage\n        .from(\"menu-images\")\n        .getPublicUrl(fileName);\n      setForm((f) => ({ ...f, image_url: data.publicUrl }));\n    } catch (err) {\n      alert(\"Image upload failed. Please try again.\");\n      console.error(err);\n    } finally {\n      setUploadingImage(false);\n    }\n  }"},{"id":"menumanager_menumanager_saveitem","label":"saveItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L150-L215","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L150"}],"snippet":"async function saveItem() {\n    if (!form.name_en.trim()) {\n      alert(\"Item name is required\");\n      return;\n    }\n    if (!form.price || isNaN(Number(form.price))) {\n      alert(\"Valid price is required\");\n      return;\n    }\n    if (!form.image_url) {\n      alert(\"Please upload an image\");\n      return;\n    }\n\n    setSaving(true);\n    try {\n      if (editingItem) {\n        const { data, error } = await supabase\n          .from(\"menu_items\")\n          .update({\n            name_en: form.name_en.trim(),\n            name_fr: form.name_fr.trim() || null,\n            description_en: form.description_en.trim() || null,\n            description_fr: form.description_fr.trim() || null,\n            price: Number(form.price),"},{"id":"menumanager_menumanager_deleteitem","label":"deleteItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L217-L230","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L217"}],"snippet":"async function deleteItem(id: string) {\n    if (!confirm(\"Delete this item? This cannot be undone.\")) return;\n    setDeletingId(id);\n    try {\n      const { error } = await supabase.from(\"menu_items\").delete().eq(\"id\", id);\n      if (error) throw error;\n      setItems((prev) => prev.filter((i) => i.id !== id));\n    } catch (err) {\n      alert(\"Failed to delete item.\");\n      console.error(err);\n    } finally {\n      setDeletingId(null);\n    }\n  }"},{"id":"menumanager_menumanager_toggleavailability","label":"toggleAvailability()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L232-L249","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L232"}],"snippet":"async function toggleAvailability(item: MenuItem) {\n    const newVal = !item.is_available;\n    setItems((prev) =>\n      prev.map((i) => (i.id === item.id ? { ...i, is_available: newVal } : i)),\n    );\n    const { error } = await supabase\n      .from(\"menu_items\")\n      .update({ is_available: newVal })\n      .eq(\"id\", item.id);\n    if (error) {\n      setItems((prev) =>\n        prev.map((i) =>\n          i.id === item.id ? { ...i, is_available: !newVal } : i,\n        ),\n      );\n      alert(\"Failed to update availability.\");\n    }\n  }"},{"id":"menumanager_menumanager_savecategory","label":"saveCategory()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L251-L278","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L251"}],"snippet":"async function saveCategory() {\n    if (!catName.en.trim()) {\n      alert(\"Category name is required\");\n      return;\n    }\n    setSaving(true);\n    try {\n      const { data, error } = await supabase\n        .from(\"categories\")\n        .insert({\n          restaurant_id: restaurant.id,\n          name_en: catName.en.trim(),\n          name_fr: catName.fr.trim() || null,\n          sort_order: categories.length,\n        })\n        .select()\n        .single();\n      if (error) throw error;\n      if (data) setCategories((prev) => [...prev, data]);\n      setCatName({ en: \"\", fr: \"\" });\n      setView(\"list\");\n    } catch (err) {\n      alert(\"Failed to save category.\");\n      console.error(err);\n    } finally {"},{"id":"menumanager_menumanager_deletecategory","label":"deleteCategory()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L280-L291","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L280"}],"snippet":"async function deleteCategory(id: string) {\n    if (\n      !confirm(\"Delete this category? Items in it will become uncategorized.\")\n    )\n      return;\n    const { error } = await supabase.from(\"categories\").delete().eq(\"id\", id);\n    if (error) {\n      alert(\"Failed to delete category.\");\n      return;\n    }\n    setCategories((prev) => prev.filter((c) => c.id !== id));\n  }"}],"edges":[{"source":"menumanager","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L3"}],"weight":1},{"source":"menumanager","target":"navigation","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L4","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L4"}],"weight":1},{"source":"menumanager","target":"client","