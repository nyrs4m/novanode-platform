ditingItem] = useState<MenuItem | null>(null);\n  const [saving, setSaving] = useState(false);\n  const [uploadingImage, setUploadingImage] = useState(false);\n  const [deletingId, setDeletingId] = useState<string | null>(null); // Corrected state variable name\n  const [isTranslating, setIsTranslating] = useState(false);\n  const fileRef = useRef<HTMLInputElement>(null);\n  const router = useRouter();\n  const supabase = createClient();\n\n  // Form state\n  const [form, setForm] = useState({\n    name_en: \"\",\n    name_fr: \"\",\n    description_en: \"\",\n    description_fr: \"\",\n    price: \"\",","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"menumanager_menumanager_handleautotranslate","label":"handleAutoTranslate()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L71-L89","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L71"}],"snippet":"async function handleAutoTranslate() {\n    if (!form.name_en.trim()) return;\n    setIsTranslating(true); // Use setIsTranslating\n    try {\n      const res = await translateToFrench(form.name_en, form.description_en);\n      if (res.nameFr) {\n        setForm((f) => ({\n          ...f,\n          name_fr: res.nameFr,\n          description_fr: res.descriptionFr,\n        }));\n      }\n    } catch (err) {\n      console.error('Translation failed:', err)\n      alert('Translation failed. Please wait a moment and try again, or enter French text manually.')\n    } finally {\n      setIsTranslating(false); // Use setIsTranslating\n    }\n  }"},{"id":"menumanager_menumanager_resetform","label":"resetForm()","file_type":"code","source_file":"C:/Users/samue/novanod