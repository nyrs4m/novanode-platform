;\n      setLoading(false);\n      return;\n    }"},{"id":"loginform_loginform_handleresendcode","label":"handleResendCode()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/login/LoginForm.tsx","source_location":"L106-L128","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/login/LoginForm.tsx","source_location":"L106"}],"snippet":"async function handleResendCode() {\n    if (resendIn > 0 || resendLoading) return;\n\n    setResendLoading(true);\n    setError(\"\");\n\n    const { error: otpError } = await supabase.auth.signInWithOtp({\n      email: email.trim(),\n      options: {\n        shouldCreateUser: false,\n      },\n    });\n\n    if (otpError) {\n      setError(\"We could not resend the code. Please try again.\");\n      setResendLoading(false);\n      return;\n    }\n\n    setOtpCode(\"\");\n    setResendIn(30);\n    setResendLoading(false);\n  }"}],"edges":[{"source":"loginform","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/login/LoginForm.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/login/LoginForm.tsx","source_location":"L3"}],"weight":1},{"source":"loginform","target":"client","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/login/LoginForm.tsx","source_location":"L4","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/login/LoginForm.tsx","source_location":"L4"}],"weight":1},{"source":"loginform","target":"navigation","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/login/LoginForm.tsx