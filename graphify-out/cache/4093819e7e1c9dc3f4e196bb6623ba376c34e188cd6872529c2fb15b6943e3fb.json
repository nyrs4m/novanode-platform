{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"qrgenerator","label":"QRGenerator.tsx","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L1"}]},{"id":"qrgenerator_qrgeneratorprops","label":"QRGeneratorProps","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L11-L14","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L11"}],"snippet":"interface QRGeneratorProps {\n  restaurant: Restaurant;\n  baseUrl: string;\n}"},{"id":"qrgenerator_tableqr","label":"TableQR","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L16-L19","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L16"}],"snippet":"interface TableQR {\n  tableNumber: number;\n  url: string;\n}"},{"id":"qrgenerator_qrgenerator","label":"QRGenerator()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L21-L235","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L21"}],"snippet":"export default function QRGenerator({ restaurant, baseUrl }: QRGeneratorProps) {\n  const [tableCount, setTableCount] = useState(5)\n  const [copiedTable, setCopiedTable] = useState<number | null>(null)\n  const [downloading, setDownloading] = useState<number | null>(null)\n  const [savingAll, setSavingAll] = useState(false)\n  const supabaseRef = useRef(createClient());\n\n  const tables: TableQR[] = Array.from({ length: tableCount }, (_, i) => ({\n    tableNumber: i + 1,\n    url: `${baseUrl}/${restaurant.slug}?table=${i + 1}`,\n  }));\n\n  async function copyUrl(table: TableQR) {\n    await navigator.clipboard.writeText(table.url);\n    setCopiedTable(table.tableNumber);\n    setTimeout(() => setCopiedTable(null), 2000);\n  }\n\n  function downloadQR(table: TableQR) {\n    setDownloading(table.tableNumber);\n    const canvas = document.getElementById(\n      `qr-${table.tableNumber}`\n    ) as HTMLCanvasElement;\n    if (!canvas) { setDownloading(null); return; }","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"qrgenerator_qrgenerator_copyurl","label":"copyUrl()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L33-L37","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L33"}],"snippet":"async function copyUrl(table: TableQR) {\n    await navigator.clipboard.writeText(table.url);\n    setCopiedTable(table.tableNumber);\n    setTimeout(() => setCopiedTable(null), 2000);\n  }"},{"id":"qrgenerator_qrgenerator_downloadqr","label":"downloadQR()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L39-L88","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L39"}],"snippet":"function downloadQR(table: TableQR) {\n    setDownloading(table.tableNumber);\n    const canvas = document.getElementById(\n      `qr-${table.tableNumber}`\n    ) as HTMLCanvasElement;\n    if (!canvas) { setDownloading(null); return; }\n\n    // Create a styled download with restaurant name + table number\n    const downloadCanvas = document.createElement(\"canvas\");\n    const padding = 40;\n    const qrSize = 240;\n    downloadCanvas.width = qrSize + padding * 2;\n    downloadCanvas.height = qrSize + padding * 2 + 80;\n\n    const ctx = downloadCanvas.getContext(\"2d\")!;\n    \n    // Background\n    ctx.fillStyle = \"#022c22\";\n    ctx.fillRect(0, 0, downloadCanvas.width, downloadCanvas.height);\n\n    // Gold border\n    ctx.strokeStyle = \"#D97706\";\n    ctx.lineWidth = 2;\n    ctx.strokeRect(8, 8, downloadCanvas.width - 16, downloadCanvas.height - 16);"},{"id":"qrgenerator_qrgenerator_downloadall","label":"downloadAll()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L90-L94","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L90"}],"snippet":"function downloadAll() {\n    tables.forEach((t, i) => {\n      setTimeout(() => downloadQR(t), i * 300);\n    });\n  }"},{"id":"qrgenerator_qrgenerator_saveqrstodatabase","label":"saveQRsToDatabase()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L96-L118","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L96"}],"snippet":"async function saveQRsToDatabase() {\n    setSavingAll(true);\n    try {\n      const records = tables.map(t => ({\n        restaurant_id: restaurant.id,\n        table_number: String(t.tableNumber),\n        qr_url: t.url,\n      }));\n\n      // Upsert — update if exists, insert if not\n      const { error } = await supabaseRef.current\n        .from(\"qr_codes\")\n        .upsert(records, { onConflict: \"restaurant_id,table_number\" });\n\n      if (error) throw error;\n      alert(`${tableCount} QR codes saved successfully!`);\n    } catch (err) {\n      console.error(err);\n      alert(\"Failed to save QR codes.\");\n    } finally {\n      setSavingAll(false);\n    }\n  }"},{"id":"qrgenerator_qrgenerator_printall","label":"printAll()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L120-L122","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L120"}],"snippet":"function printAll() {\n    window.print();\n  }"}],"edges":[{"source":"qrgenerator","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/QRGenerator.tsx","source_location":"L3"}],"weight":1},{"source":"qrgenerator","target":"qrcode","relation":"imports_from","confidence