n [...prev, { item, quantity: 1 }];\n    });\n  }"},{"id":"menuclient_menuclient_removeitem","label":"removeItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L476-L484","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L476"}],"snippet":"function removeItem(id: string) {\n    setOrder((prev) =>\n      prev\n        .map((ci) =>\n          ci.item.id === id ? { ...ci, quantity: ci.quantity - 1 } : ci,\n        )\n        .filter((ci) => ci.quantity > 0),\n    );\n  }"},{"id":"menuclient_menuclient_placeorder","label":"placeOrder()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L487-L546","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L487"}],"snippet":"async function placeOrder() {\n    if (order.length === 0) return;\n    setPlacingOrder(true);\n\n    try {\n      const supabase = supabaseRef.current;\n      const { data: session } = await supabase\n        .from(\"table_sessions\")\n        .select(\"is_active, bill_status\")\n        .eq(\"session_token\", sessionToken)\n        .maybeSingle();\n\n      if (session && (!session.is_active || (session.bill_status !== 'none' && session.bill_status))) {\n        setPlacingOrder(false);\n        setShowOrder(false);\n        setOrder([]);\n        alert(session.is_active ? \"The bill has been presented. No more orders can be placed.\" : \"Your table session has ended.\");\n        return;\n      }\n\n      const { error: orderError } = await supabase.from(\"orders\").insert({\n     