 const [signalsCount, setSignalsCount] = useState(initialSignals);\n  const [recentOrders, setRecentOrders] =\n    useState<Order[]>(initialRecentOrders);\n  const [todayLedger, setTodayLedger] = useState<LedgerRow | null>(null);","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"dashboardhome_dashboardhome_refreshtodayrevenue","label":"refreshTodayRevenue()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L113-L153","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L113"}],"snippet":"async function refreshTodayRevenue() {\n      const today = new Date().toISOString().split(\"T\")[0];\n      const todayStart = `${today}T00:00:00.000Z`;\n      const tomorrowStartDate = new Date(todayStart);\n      tomorrowStartDate.setUTCDate(tomorrowStartDate.getUTCDate() + 1);\n      const tomorrowStart = tomorrowStartDate.toISOString();\n\n      try {\n        // Fetch completed session tokens for today\n        const { data: completedSessions } = await supabase\n          .from(\"table_sessions\")\n          .select(\"session_token\")\n          .eq(\"restaurant_id\", restaurant.id)\n          .eq(\"status\", \"completed\")\n          .gte(\"closed_at\", todayStart)\n          .lt(\"closed_at\", tomorrowStart);\n\n        const completedSessionTokens =\n          completedSessions?.map((s) => s.session_token) ?? [];\n\n        // Fetch orders from completed sessions\n        if (completedSessionTokens.length > 0) {\n          const { data: revenueOrders } = await supabase\n            .from(\"orders\")\n            .select(\"total_amount\")"},{"id":"dashboardhome_dashboardhome_refreshcounts","label":"refreshCounts()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L155-L200","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L155"}],"snippet":"async function refreshCounts() {\n      // Run revenue refresh in parallel without blocking other counts\n      refreshTodayRevenue().catch(() => {});\n\n      const [ordersRes, tablesRes, signalsRes, recentRes, ledgerRes] =\n        await Promise.all([\n          supabase\n            .from(\"orders\")\n            .select(\"*\", { count: \"exact\", head: true })\n            .eq(\"restaurant_id\", restaurant.id)\n            .in(\"status\", [\"Pending\", \"Preparing\"]),\n\n          supabase\n            .from(\"table_sessions\")\n            .select(\"*\", { count: \"exact\", head: true })\n            .eq(\"restaurant_id\", restaurant.id)\n            .eq(\"is_active\", true),\n\n          supabase\n            .from(\"waiter_signals\")\n            .select(\"*\", { count: \"exact\", head: true })\n            .eq(\"restaurant_id\", restaurant.id)\n            .eq(\"is_resolved\", false),\n\n          supabase"},{"id":"dashboardhome_dashboardhome_handlelogout","label":"handleLogout()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L292-L297","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/components/DashboardHome.tsx","source_location":"L292"}],"snippet":"async function handleLogout() {\n    await supabase.auth.signOut();\n    startTransition(() => {\n      router.push(\"/login\");\n    });\n  }"}],"edges":[{"source":"dashboa