] = useState<MenuItem | null>(null)\n  const [saving, setSaving] = useState(false)\n  const [uploadingImage, setUploadingImage] = useState(false)\n  const [deletingId, setDeletingId] = useState<string | null>(null)\n  const fileRef = useRef<HTMLInputElement>(null)\n  const router = useRouter()\n  const supabase = createClient()\n\n  // Form state\n  const [form, setForm] = useState({\n    name_en: '',\n    name_fr: '',\n    description_en: '',\n    description_fr: '',\n    price: '',\n    category_id: '',","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"menumanager_menumanager_resetform","label":"resetForm()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L57-L64","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L57"}],"snippet":"function resetForm() {\n    setForm({\n      name_en: '', name_fr: '', description_en: '',\n      description_fr: '', price: '', category_id: '',\n      image_url: '', is_available: true, is_starter: false,\n    })\n    setEditingItem(null)\n  }"},{"id":"menumanager_menumanager_openadditem","label":"openAddItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L66-L69","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L66"}],"snippet":"function openAddItem() {\n    resetForm()\n    setView('add-item')\n  }"},{"id":"menumanager_menumanager_openedititem","label":"openEditItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L71-L85","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L71"}],"snippet":"function openEditItem(item: MenuItem) {\n    setForm({\n      name_en: item.name_en,\n      name_fr: item.name_fr ?? '',\n      description_en: item.description_en ?? '',\n      description_fr: item.description_fr ?? '',\n      price: String(item.price),\n      category_id: item.category_id ?? '',\n      image_url: item.image_url,\n      is_available: item.is_available ?? true,\n      is_starter: item.is_starter ?? false,\n    })\n    setEditingItem(item)\n    setView('edit-item')\n  }"},{"id":"menumanager_menumanager_handleimageupload","label":"handleImageUpload()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L87-L106","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L87"}],"snippet":"async function handleImageUpload(e: React.ChangeEvent<HTMLInputElement>) {\n    const file = e.target.files?.[0]\n    if (!file) return\n    setUploadingImage(true)\n    try {\n      const compressed = await compressImage(file)\n      const fileName = `${restaurant.id}/${Date.now()}.webp`\n      const { error } = await supabase.storage\n        .from('menu-images')\n        .upload(fileName, compressed, { contentType: 'image/webp' })\n      if (error) throw error\n      const { data } = supabase.storage.from('menu-images').getPublicUrl(fileName)\n      setForm(f => ({ ...f, image_url: data.publicUrl }))\n    } catch (err) {\n      alert('Image upload failed. Please try again.')\n      console.error(err)\n    } finally {\n      setUploadingImage(false)\n    }\n  }"},{"id":"menumanager_menumanager_saveitem","label":"saveItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L108-L160","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L108"}],"snippet":"async function saveItem() {\n    if (!form.name_en.trim()) { alert('Item name is required'); return }\n    if (!form.price || isNaN(Number(form.price))) { alert('Valid price is required'); return }\n    if (!form.image_url) { alert('Please upload an image'); return }\n\n    setSaving(true)\n    try {\n      if (editingItem) {\n        const { data, error } = await supabase\n          .from('menu_items')\n          .update({\n            name_en: form.name_en.trim(),\n            name_fr: form.name_fr.trim() || null,\n            description_en: form.description_en.trim() || null,\n            description_fr: form.description_fr.trim() || null,\n            price: Number(form.price),\n            category_id: form.category_id || null,\n            image_url: form.image_url,\n            is_available: form.is_available,\n            is_starter: form.is_starter,\n          })\n          .eq('id', editingItem.id)\n          .select().single()\n        if (error) throw error\n        if (data) setItems(prev => prev.map(i => i.id === data.id ? data : i))"},{"id":"menumanager_menumanager_deleteitem","label":"deleteItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L162-L175","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L162"}],"snippet":"async function deleteItem(id: string) {\n    if (!confirm('Delete this item? This cannot be undone.')) return\n    setDeletingId(id)\n    try {\n      const { error } = await supabase.from('menu_items').delete().eq('id', id)\n      if (error) throw error\n      setItems(prev => prev.filter(i => i.id !== id))\n    } catch (err) {\n      alert('Failed to delete item.')\n      console.error(err)\n    } finally {\n      setDeletingId(null)\n    }\n  }"},{"id":"menumanager_menumanager_toggleavailability","label":"toggleAvailability()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L177-L188","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L177"}],"snippet":"async function toggleAvailability(item: MenuItem) {\n    const newVal = !item.is_available\n    setItems(prev => prev.map(i => i.id === item.id ? { ...i, is_available: newVal } : i))\n    const { error } = await supabase\n      .from('menu_items')\n      .update({ is_available: newVal })\n      .eq('id', item.id)\n    if (error) {\n      setItems(prev => prev.map(i => i.id === item.id ? { ...i, is_available: !newVal } : i))\n      alert('Failed to update availability.')\n    }\n  }"},{"id":"menumanager_menumanager_savecategory","label":"saveCategory()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L190-L213","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L190"}],"snippet":"async function saveCategory() {\n    if (!catName.en.trim()) { alert('Category name is required'); return }\n    setSaving(true)\n    try {\n      const { data, error } = await supabase\n        .from('categories')\n        .insert({\n          restaurant_id: restaurant.id,\n          name_en: catName.en.trim(),\n          name_fr: catName.fr.trim() || null,\n          sort_order: categories.length,\n        })\n        .select().single()\n      if (error) throw error\n      if (data) setCategories(prev => [...prev, data])\n      setCatName({ en: '', fr: '' })\n      setView('list')\n    } catch (err) {\n      alert('Failed to save category.')\n      console.error(err)\n    } finally {\n      setSaving(false)\n    }\n  }"},{"id":"menumanager_menumanager_deletecategory","label":"deleteCategory()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L215-L220","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L215"}],"snippet":"async function deleteCategory(id: string) {\n    if (!confirm('Delete this category? Items in it will become uncategorized.')) return\n    const { error } = await supabase.from('categories').delete().eq('id', id)\n    if (error) { alert('Failed to delete category.'); return }\n    setCategories(prev => prev.filter(c => c.id !== id))\n  }"}],"edges":[{"source":"menumanager","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L3","layer":"base","provenance":[