────────────────\n  const fetchOrders = useCallback(async () => {\n    const { data } = await supabase\n      .from(\"orders\")\n      .select(\"*\")\n      .eq(\"session_token\", sessionToken)\n      .order(\"created_at\", { ascending: false });","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"ordertracker_ordertracker_pressdelaybell","label":"pressDelayBell()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/OrderTracker.tsx","source_location":"L195-L214","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/OrderTracker.tsx","source_location":"L195"}],"snippet":"async function pressDelayBell(orderId: string) {\n    if (bellPressed.has(orderId)) return;\n    setBellPressed((p) => new Set([...p, orderId]));\n    playWaiterCall();\n\n    await supabase.from(\"waiter_signals\").insert({\n      restaurant_id: restaurant.id,\n      table_number: tableNumber,\n      customer_name: customerName,\n      signal_type: \"call_waiter\",\n    });\n\n    setTimeout(() => {\n      setBellPressed((p) => {\n        const next = new Set(p);\n        next.delete(orderId);\n        return next;\n      });\n    }, 30000);\n  }"}],"edges":[{"source":"ordertracker","target":"react","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/OrderTracker.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/OrderTracker.tsx","source_location":"L3"}],"weight":1},{"source":"ordertracker","target":"client","relation":"imports_from","confidence":"EXTRACTED","source_file":"C:/Users/samue/novano