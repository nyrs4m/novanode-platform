":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L151"}],"snippet":"function BillSplitter({\n  total,\n  currency,\n  ui,\n}: {\n  total: number;\n  currency: string;\n  ui: (typeof UI_TEXT)[\"en\"];\n}) {\n  const [people, setPeople] = useState(2);\n  const perPerson = total / people;\n\n  return (\n    <div\n      style={{\n        background: \"var(--cream-06)\",\n        border: \"1px solid var(--cream-15)\",\n        borderRadius: 16,\n        padding: \"16px\",\n      }}\n    >\n      <p\n        className=\"t-eyebrow\"\n        style={{ marginBottom: 12, textAlign: \"center\" }}\n      >","node_kind":"component"},{"id":"menuclient_menuclient","label":"MenuClient()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L262-L2090","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L262"}],"snippet":"export default function MenuClient({\n  restaurant,\n  categories,\n  menuItems,\n  dailySpecial,\n  sessionToken,\n  customerName,\n  tableNumber,\n}: MenuClientProps) {\n  const [activeCategory, setActiveCategory] = useState<string | null>(null);\n  const [order, setOrder] = useState<CartItem[]>([]);\n  const [showOrder, setShowOrder] = useState(false);\n  const [sentSignals, setSentSignals] = useState<Signal[]>([]);\n  const [placingOrder, setPlacingOrder] = useState(false);\n  const [orderSuccess, setOrderSuccess] = useState(false);\n  const [showBillPopup, setShowBillPopup] = useState(false);\n  const [billLocked, setBillLocked] = useState(false);\n  const [showReceipt, setShowReceipt] = useState(false);\n  const [sessionId, setSessionId] = useState<string | null>(null);\n  const [staffList, setStaffList] = useState<Tables<\"restaurant_staff\">[]>([]);\n  const [liveMenuItems, setLiveMenuItems] = useState<MenuItem[]>(menuItems);\n  const [lang, setLang] = useState<\"en\" | \"fr\">(() => {\n    if (typeof window === \"undefined\") return \"en\";\n    return (localStorage.getItem(\"nn_lang\") as \"en\" | \"fr\") ?? \"en\";\n  });","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"menuclient_menuclient_fetchpromos","label":"fetchPromos()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L327-L336","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L327"}],"snippet":"async function fetchPromos() {\n      const { data } = await supabaseRef.current\n        .from(\"restaurant_promos\")\n        .select(\"title, description, image_url\")\n        .eq(\"restaurant_id\", restaurant.id)\n        .eq(\"is_active\", true)\n        .lte(\"start_date\", new Date().toISOString())\n        .gte(\"end_date\", new Date().toISOString());\n      if (data && data.length > 0) setPromos(data);\n    }"},{"id":"menuclient_menuclient_fetchstaff","label":"fetchStaff()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L343-L350","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L343"}],"snippet":"async function fetchStaff() {\n      const { data } = await supabaseRef.current\n        .from(\"restaurant_staff\")\n        .select(\"id, display_name, role\")\n        .eq(\"restaurant_id\", restaurant.id)\n        .eq(\"role\", \"waiter\");\n      if (data && data.length > 0) setStaffList(data as any);\n    }"},{"id":"menuclient_menuclient_handlescroll","label":"handleScroll()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L498-L520","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L498"}],"snippet":"handleScroll = () => {\n      const currentY = window.scrollY;\n\n      if (currentY < 50) {\n        if (!navVisibleRef.current) {\n          navVisibleRef.current = true;\n          setNavVisible(true);\n        }\n        setPillsExpanded(false);\n      } else if (currentY > lastScrollY.current + 8) {\n        if (navVisibleRef.current) {\n          navVisibleRef.current = false;\n          setNavVisible(false);\n        }\n        setPillsExpanded(false);\n      } else if (currentY < lastScrollY.current - 8) {\n        if (!navVisibleRef.current) {\n          navVisibleRef.current = true;\n          setNavVisible(true);\n        }\n      }\n      lastScrollY.current = currentY;\n    }"},{"id":"menuclient_menuclient_additem","label":"addItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L526-L535","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L526"}],"snippet":"function addItem(item: MenuItem) {\n    setOrder((prev) => {\n      const ex = prev.find((ci) => ci.item.id === item.id);\n      if (ex)\n        return prev.map((ci) =>\n          ci.item.id === item.id ? { ...ci, quantity: ci.quantity + 1 } : ci,\n        );\n      return [...prev, { item, quantity: 1 }];\n    });\n  }"},{"id":"menuclient_menuclient_placeorder","label":"placeOrder()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L538-L605","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L538"}],"snippet":"async function placeOrder() {\n    if (order.length === 0) return;\n    setPlacingOrder(true);\n\n    try {\n      const supabase = supabaseRef.current;\n      const { data: session } = await supabase\n        .from(\"table_sessions\")\n        .select(\"is_active, bill_status\")\n        .eq(\"session_token\", sessionToken)\n        .maybeSingle();\n\n      if (\n        session &&\n        (!session.is_active ||\n          (session.bill_status !== \"none\" && session.bill_status))\n      ) {\n        setPlacingOrder(false);\n        setShowOrder(false);\n        setOrder([]);\n        alert(\n          session.is_active\n            ? \"The bill has been presented. No more orders can be placed.\"\n            : \"Your table session has ended.\",\n        );"},{"id":"menuclient_menuclient_sendsignal","label":"sendSignal()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L608-L621","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L608"}],"snippet":"async function sendSignal(type: Signal) {\n    if (sentSignals.includes(type)) return;\n    setSentSignals((prev) => [...prev, type]);\n    await supabaseRef.current.from(\"waiter_signals\").insert({\n      restaurant_id: restaurant.id,\n      table_number: tableNumber,\n      customer_name: customerName,\n      signal_type: type,\n    });\n    setTimeout(\n      () => setSentSignals((prev) => prev.filter((s) => s !== type)),\n      5000,\n    );\n  }"},{"id":"menuclient_menuclient_togglelang","label":"toggleLang()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L624-L630","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L624"}],"snippet":"function toggleLang() {\n    setLang((prev) => {\n      const next = prev === \"en\" ? \"fr\" : \"en\";\n      localStorage.setItem(\"nn_lang\", next);\n      return next;\n    });\n  }"},{"id":"menuclient_menuclient_t","label":"t()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L632-L635","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L632"}],"snippet":"function t(en: string | null, fr: string | null | undefined): string {\n    if (lang === \"fr\" && fr) return fr;\n    return en ?? \"\";\n  }"},{"id":"menuclient_menuclient_removeitem","label":"removeItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L656-L664","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(customer)/[restaurant_slug]/components/MenuClient.tsx","source_location":"L656"}],"snippet":"function removeItem(id: string) {\n    setOrder((prev) =>\n      prev\n        .map((ci) =>\n          ci.item.id === id ? { ...ci, quanti