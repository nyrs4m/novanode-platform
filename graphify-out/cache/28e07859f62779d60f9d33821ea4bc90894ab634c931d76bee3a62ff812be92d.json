d/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L80"}],"snippet":"async function handleAutoTranslate() {\n    if (!form.name_en.trim()) return;\n    setIsTranslating(true); // Use setIsTranslating\n    try {\n      const res = await translateToFrench(form.name_en, form.description_en);\n      if (res.nameFr) {\n        setForm((f) => ({\n          ...f,\n          name_fr: res.nameFr,\n          description_fr: res.descriptionFr,\n        }));\n      }\n    } catch (err) {\n      console.error(\"Translation failed:\", err);\n      alert(\n        \"Translation failed. Please wait a moment and try again, or enter French text manually.\",\n      );\n    } finally {\n      setIsTranslating(false); // Use setIsTranslating\n    }\n  }"},{"id":"menumanager_menumanager_resetform","label":"resetForm()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L102-L123","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L102"}],"snippet":"function resetForm() {\n    setForm({\n      name_en: \"\",\n      name_fr: \"\",\n      description_en: \"\",\n      description_fr: \"\",\n      price: \"\",\n      category_id: \"\",\n      image_url: \"\",\n      is_available: true,\n      is_starter: false,\n    });\n    setEditingItem(null);\n    setModifierGroups([]);\n    setShowAddGroup(false);\n    setNewGroupName('');\n    setNewGroupRequired(false);\n    setNewGroupMulti(false);\n    setAddingOptionForGroup(null);\n    setNewOptionName('');\n    setNewOptionPrice('0');\n  }"},{"id":"menumanager_menumanager_openadditem","label":"openAddItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.t