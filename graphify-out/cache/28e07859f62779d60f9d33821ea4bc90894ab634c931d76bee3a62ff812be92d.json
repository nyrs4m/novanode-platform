\n      .from('modifier_groups')\n      .select('*, modifier_options(*)')\n      .eq('menu_item_id', itemId)\n      .order('sort_order');\n    setModifierGroups(data ?? []);\n  }"},{"id":"menumanager_menumanager_handleimageupload","label":"handleImageUpload()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L156-L178","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L156"}],"snippet":"async function handleImageUpload(e: React.ChangeEvent<HTMLInputElement>) {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    setUploadingImage(true);\n    try {\n      const compressed = await compressImage(file);\n      const fileName = `${restaurant.id}/${Date.now()}.webp`;\n      const supabase = getSupabase();\n      const { error } = await supabase.storage\n        .from(\"menu-images\")\n        .upload(fileName, compressed, { contentType: \"image/webp\" });\n      if (error) throw error;\n      const { data } = supabase.storage\n        .from(\"menu-images\")\n        .getPublicUrl(fileName);\n      setForm((f) => ({ ...f, image_url: data.publicUrl }));\n    } catch (err) {\n      alert(\"Image upload failed. Please try again.\");\n      console.error(err);\n    } finally {\n      setUploadingImage(false);\n    }\n  }"},{"id":"menumanager_menumanager_saveitem","label":"saveItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L180-L246","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L180"}],"snippet":"async function saveItem() {\n    if (!form.name_en.trim()) {\n      alert(\"Item name is required\");\n      return;\n    }\n    if (!form.price || isNaN(Number(form.price))) {\n      alert(\"Valid price is required\");\n      return;\n    }\n    if (!form.image_url) {\n      alert(\"Please upload an image\");\n      return;\n    }\n\n    setSaving(true);\n    try {\n      const supabase = getSupabase();\n      if (editingItem) {\n        const { data, error } = await supabase\n          .from(\"menu_items\")\n          .update({\n            name_en: form.name_en.trim(),\n            name_fr: form.name_fr.trim() || null,\n            description_en: form.description_en.trim() || null,\n            description_fr: form.description_fr.trim() || null,"},{"id":"menumanager_menumanager_deleteitem","label":"deleteItem()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L248-L262","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L248"}],"snippet":"async function deleteItem(id: string) {\n    if (!confirm(\"Delete this item? This cannot be undone.\")) return;\n    setDeletingId(id);\n    try {\n      const supabase = getSupabase();\n      const { error } = await supabase.from(\"menu_items\").delete().eq(\"id\", id);\n      if (error) throw error;\n      setItems((prev) => prev.filter((i) => i.id !== id));\n    } catch (err) {\n      alert(\"Failed to delete item.\");\n      console.error(err);\n    } finally {\n      setDeletingId(null);\n    }\n  }"},{"id":"menumanager_menumanager_toggleavailability","label":"toggleAvailability()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L264-L282","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L264"}],"snippet":"async function toggleAvailability(item: MenuItem) {\n    const newVal = !item.is_available;\n    setItems((prev) =>\n      prev.map((i) => (i.id === item.id ? { ...i, is_available: newVal } : i)),\n    );\n    const supabase = getSupabase();\n    const { error } = await supabase\n      .from(\"menu_items\")\n      .update({ is_available: newVal })\n      .eq(\"id\", item.id);\n    if (error) {\n      setItems((prev) =>\n        prev.map((i) =>\n          i.id === item.id ? { ...i, is_available: !newVal } : i,\n        ),\n      );\n      alert(\"Failed to update availability.\");\n    }\n  }"},{"id":"menumanager_menumanager_savecategory","label":"saveCategory()","file_type":"code","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L284-L312","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"C:/Users/samue/novanode-platform/app/(admin)/dashboard/[restaurant_slug]/menu/components/MenuManager.tsx","source_location":"L284"}],"snippet":"async function saveCategory() {\n    if (!catName.en.trim()) {\n      alert(\"Category name is required\");\n      return;\n    }\n    setSaving(true);\n    try {\n      const supabase = getSupabase();\n      const { data, error } = await supabase\n        .from(\"categories\")\n        .insert({\n          restaurant_id: restaurant.id,\n          name_en: catName.en.trim(),\n          name_fr: catName.fr.trim() || null,\n          sort_order: categories.length,\n        })\n        .select()\n        .single();\n      if (error) throw error;\n      if (data) setCategories((prev) => [...prev, data]);\n      s